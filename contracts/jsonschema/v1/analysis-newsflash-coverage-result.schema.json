{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "configuredSites": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuredsites"
        },
        "earliestAvailableAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earliestavailableat"
        },
        "historyEnabled": {
          "title": "Historyenabled",
          "type": "boolean"
        },
        "latestAvailableAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latestavailableat"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "historyEnabled",
        "complete"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "boardKey": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Boardkey",
          "type": "string"
        },
        "captureId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captureid"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidenceId": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Evidenceid",
          "type": "string"
        },
        "firstSeenAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firstseenat"
        },
        "hot": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hot"
        },
        "itemId": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Itemid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "lastSeenAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastseenat"
        },
        "observedAt": {
          "format": "date-time",
          "title": "Observedat",
          "type": "string"
        },
        "publishedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publishedat"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "site": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Site",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "updateTime": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updatetime"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "kind",
        "site",
        "boardKey",
        "evidenceId",
        "itemId",
        "title",
        "observedAt"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ItemKind": {
      "enum": [
        "hotlist",
        "newsflash",
        "gold"
      ],
      "title": "ItemKind",
      "type": "string"
    },
    "NewsflashCoverageSummary": {
      "additionalProperties": false,
      "properties": {
        "durationApproximate": {
          "title": "Durationapproximate",
          "type": "boolean"
        },
        "durationHours": {
          "default": 0,
          "minimum": 0,
          "title": "Durationhours",
          "type": "number"
        },
        "earliestPlatform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earliestplatform"
        },
        "eventCount": {
          "minimum": 0,
          "title": "Eventcount",
          "type": "integer"
        },
        "firstSeenApproximate": {
          "title": "Firstseenapproximate",
          "type": "boolean"
        },
        "firstSeenAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firstseenat"
        },
        "keyword": {
          "title": "Keyword",
          "type": "string"
        },
        "lastSeenApproximate": {
          "title": "Lastseenapproximate",
          "type": "boolean"
        },
        "lastSeenAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastseenat"
        },
        "mentionCount": {
          "minimum": 0,
          "title": "Mentioncount",
          "type": "integer"
        },
        "platformCount": {
          "minimum": 0,
          "title": "Platformcount",
          "type": "integer"
        }
      },
      "required": [
        "keyword",
        "firstSeenApproximate",
        "lastSeenApproximate",
        "durationApproximate",
        "eventCount",
        "mentionCount",
        "platformCount"
      ],
      "title": "NewsflashCoverageSummary",
      "type": "object"
    },
    "NewsflashEvent": {
      "additionalProperties": false,
      "properties": {
        "canonicalTitle": {
          "minLength": 1,
          "title": "Canonicaltitle",
          "type": "string"
        },
        "firstPlatform": {
          "title": "Firstplatform",
          "type": "string"
        },
        "firstSeenAt": {
          "format": "date-time",
          "title": "Firstseenat",
          "type": "string"
        },
        "mentionCount": {
          "minimum": 1,
          "title": "Mentioncount",
          "type": "integer"
        },
        "platforms": {
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        }
      },
      "required": [
        "canonicalTitle",
        "firstSeenAt",
        "firstPlatform",
        "platforms",
        "mentionCount"
      ],
      "title": "NewsflashEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysisComplete": {
      "title": "Analysiscomplete",
      "type": "boolean"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/NewsflashEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "scannedCount": {
      "minimum": 0,
      "title": "Scannedcount",
      "type": "integer"
    },
    "summary": {
      "$ref": "#/$defs/NewsflashCoverageSummary"
    }
  },
  "required": [
    "summary",
    "events",
    "evidence",
    "analysisComplete",
    "scannedCount",
    "coverage"
  ],
  "title": "NewsflashCoverageAnalysisData",
  "type": "object"
}
